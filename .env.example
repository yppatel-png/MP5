# ==========================================
# Adobe Personalised Learning Buddy Configuration
# ==========================================

# Model Provider Configuration (LiteLLM)
# Supported prefixes: gemini/<model>, openai/<model>, azure/<deployment>, etc.
LLM_MODEL=gemini/gemini-3.5-flash-lite
# Optional. Replace with a Gemini API key to enable live Buddy responses.
# Without a key, grounded deterministic Buddy responses remain available.
LLM_API_KEY=your_llm_api_key_here

# Optional: Custom endpoint URL (e.g. for Azure OpenAI or local self-hosted vLLM/Ollama)
# LLM_API_BASE=https://your-custom-endpoint.com

# Optional: Embedding model for hybrid retrieval (BM25 works offline by default)
# EMBEDDING_MODEL=gemini/text-embedding-004

# Database Configuration
# Default for standalone / quick start: SQLite
# For production / docker-compose: postgresql://buddy_user:buddy_pass@db:5432/buddy_db
INSTITUTE_PROFILE=iit_bhilai
DATABASE_URL=sqlite:///./data/buddy_bhilai.db

# Application Configuration
APP_HOST=0.0.0.0
APP_PORT=8000
# Host-side port; set to 8001 if port 8000 is already in use.
APP_PORT_HOST=8000
APP_ENV=development
LOG_LEVEL=INFO

# Offline Mode Toggle (Set to true to force deterministic fallbacks with zero LLM network calls)
OFFLINE_MODE=false

# Admin API Security Token (Protects admin data mutation endpoints)
ADMIN_API_TOKEN=adm_secret_token_15
